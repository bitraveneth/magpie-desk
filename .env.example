# Pooled Prisma Postgres URL. Keep the real value in .env. Never commit it.
DATABASE_URL="postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Direct URL for migrations. Use the non-pooled host when Prisma provides one.
DIRECT_URL="postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"
# Staff login. Keep the real values in .env.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="use-a-long-random-string"
